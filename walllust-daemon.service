[Unit]
Description=Walllust Wallpaper Daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Absolute path so the distribution packages, which install to
# /usr/bin, get a working unit. install.sh rewrites this to
# %h/.local/bin for a from-source install.
ExecStart=/usr/bin/walllust-daemon
Restart=always
RestartSec=3
Slice=session.slice
Environment=WAYLAND_DISPLAY
Environment=XDG_RUNTIME_DIR

[Install]
WantedBy=default.target
